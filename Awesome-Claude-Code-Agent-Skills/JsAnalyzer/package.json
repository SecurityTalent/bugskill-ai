{
  "name": "@pai/jsanalyzer",
  "version": "2.0.0",
  "description": "Orchestrator-based JavaScript security analysis for PAI",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./configs/*": "./src/configs/*.ts",
    "./orchestrators/*": "./src/orchestrators/*.ts"
  },
  "scripts": {
    "lint": "bun run --bun biome check src/",
    "lint:fix": "bun run --bun biome check --write src/",
    "format": "bun run --bun biome format --write src/",
    "typecheck": "bun run --bun tsc --noEmit"
  },
  "keywords": [
    "security",
    "javascript",
    "static-analysis",
    "bug-bounty",
    "vulnerability-scanning",
    "orchestrator",
    "pai"
  ],
  "author": "xssdoctor",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "latest"
  }
}
