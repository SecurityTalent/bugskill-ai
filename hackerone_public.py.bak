#!/usr/bin/env python3

import json
import os
import sys
import time
from pathlib import Path

import requests


# ============================================================
# Configuration
# ============================================================

API_URL = "https://api.hackerone.com/v1/hackers/hacktivity"

API_IDENTIFIER = os.getenv("H1_API_IDENTIFIER", "")
API_TOKEN = os.getenv("H1_API_TOKEN", "")

# HackerOne currently supports 1-100 per page.
# We intentionally request 50 so every page is processed in batches of 50.
PAGE_SIZE = 50

OUTPUT_FILE = "hackerone_public_reports.json"

REQUEST_TIMEOUT = 60
RETRY_WAIT = 30
PAGE_DELAY = 1

# Optional safety limit.
# 0 = unlimited (continue until HackerOne returns an empty page).
MAX_PAGES = int(os.getenv("H1_MAX_PAGES", "0"))


# ============================================================
# Helpers
# ============================================================

def save_json(reports):
    """Save collected reports to JSON."""
    output = {
        "source": "HackerOne Hacktivity",
        "filter": "disclosed:true",
        "page_size_requested": PAGE_SIZE,
        "total_collected": len(reports),
        "reports": reports,
    }

    Path(OUTPUT_FILE).write_text(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
        ),
        encoding="utf-8",
    )


def report_key(report):
    """Create a unique key for a report."""
    if not isinstance(report, dict):
        return None

    report_id = report.get("id")

    if report_id:
        return str(report_id)

    attributes = report.get("attributes", {})

    if isinstance(attributes, dict):
        url = attributes.get("url")
        if url:
            return str(url)

        title = attributes.get("title")
        if title:
            return str(title)

    return json.dumps(report, sort_keys=True)


def extract_reports(data):
    """Extract reports from HackerOne JSON response."""
    if not isinstance(data, dict):
        return []

    reports = data.get("data", [])

    if not isinstance(reports, list):
        return []

    return reports


# ============================================================
# Main downloader
# ============================================================

def main():

    # --------------------------------------------------------
    # Check credentials
    # --------------------------------------------------------

    if not API_IDENTIFIER:
        print("[!] H1_API_IDENTIFIER is missing.")
        print()
        print("Set it with:")
        print("export H1_API_IDENTIFIER='YOUR_IDENTIFIER'")
        sys.exit(1)

    if not API_TOKEN:
        print("[!] H1_API_TOKEN is missing.")
        print()
        print("Set it with:")
        print("export H1_API_TOKEN='YOUR_NEW_API_TOKEN'")
        sys.exit(1)

    print("==============================================")
    print(" HackerOne Public Hacktivity Downloader")
    print("==============================================")
    print()
    print(f"[*] API: {API_URL}")
    print(f"[*] Page size: {PAGE_SIZE}")
    print(f"[*] Output: {OUTPUT_FILE}")

    if MAX_PAGES:
        print(f"[*] Max pages: {MAX_PAGES}")
    else:
        print("[*] Max pages: unlimited")

    print()

    # --------------------------------------------------------
    # Session
    # --------------------------------------------------------

    session = requests.Session()

    session.auth = (
        API_IDENTIFIER,
        API_TOKEN,
    )

    session.headers.update({
        "Accept": "application/json",
        "User-Agent": "HackerOne-Public-Hacktivity-Downloader/2.0",
    })

    # --------------------------------------------------------
    # Pagination
    #
    # HackerOne documents page[number] and page[size].
    # We therefore explicitly request:
    #
    # page[number]=1&page[size]=50
    # page[number]=2&page[size]=50
    # page[number]=3&page[size]=50
    #
    # This does NOT depend on links.next being returned.
    # --------------------------------------------------------

    all_reports = []
    seen_reports = set()

    page = 1

    while True:

        if MAX_PAGES and page > MAX_PAGES:
            print()
            print(f"[!] Reached MAX_PAGES={MAX_PAGES}.")
            break

        print(f"[*] Downloading page {page}...")

        params = {
            "queryString": "disclosed:true",
            "page[number]": page,
            "page[size]": PAGE_SIZE,
            "sort": "-disclosed_at",
        }

        # ----------------------------------------------------
        # Request with retry handling
        # ----------------------------------------------------

        while True:

            try:
                response = session.get(
                    API_URL,
                    params=params,
                    timeout=REQUEST_TIMEOUT,
                )

            except requests.RequestException as error:

                print(f"[!] Network error: {error}")
                print(f"[*] Retrying in {RETRY_WAIT} seconds...")
                time.sleep(RETRY_WAIT)
                continue

            # ------------------------------------------------
            # Rate limit
            # ------------------------------------------------

            if response.status_code == 429:

                retry_after = response.headers.get("Retry-After")

                try:
                    wait_time = int(retry_after)
                except (TypeError, ValueError):
                    wait_time = RETRY_WAIT

                print("[!] Rate limited (429).")
                print(f"[*] Waiting {wait_time} seconds...")
                time.sleep(wait_time)
                continue

            break

        # ----------------------------------------------------
        # Authentication errors
        # ----------------------------------------------------

        if response.status_code == 401:
            print()
            print("[!] HTTP 401 Unauthorized")
            print("[!] API authentication failed.")
            print("[*] Check H1_API_IDENTIFIER and H1_API_TOKEN.")
            sys.exit(1)

        if response.status_code == 403:
            print()
            print("[!] HTTP 403 Forbidden")
            print("[!] API access is not allowed.")
            print("[*] Check your HackerOne API permissions.")
            sys.exit(1)

        # ----------------------------------------------------
        # Other HTTP errors
        # ----------------------------------------------------

        if response.status_code != 200:
            print()
            print(f"[!] HTTP {response.status_code}")
            print(response.text[:2000])
            sys.exit(1)

        # ----------------------------------------------------
        # Parse JSON
        # ----------------------------------------------------

        try:
            data = response.json()

        except ValueError:
            print("[!] HackerOne returned invalid JSON.")
            print(response.text[:2000])
            sys.exit(1)

        # ----------------------------------------------------
        # Extract reports
        # ----------------------------------------------------

        reports = extract_reports(data)

        if not reports:
            print()
            print("[+] No more reports.")
            break

        # ----------------------------------------------------
        # Add reports and remove duplicates
        # ----------------------------------------------------

        new_reports = 0

        for report in reports:

            key = report_key(report)

            if key is None or key in seen_reports:
                continue

            seen_reports.add(key)
            all_reports.append(report)
            new_reports += 1

        # ----------------------------------------------------
        # Save progress after every page
        # ----------------------------------------------------

        save_json(all_reports)

        print(f"[+] Page {page}: {len(reports)} reports received")
        print(f"[+] New reports: {new_reports}")
        print(f"[+] Total collected: {len(all_reports)}")
        print()

        # ----------------------------------------------------
        # Continue to the next page.
        #
        # We intentionally DO NOT stop when len(reports) < PAGE_SIZE.
        # If HackerOne returns a partial page, the next request
        # confirms whether another page exists.
        # ----------------------------------------------------

        page += 1

        time.sleep(PAGE_DELAY)

    # --------------------------------------------------------
    # Final save
    # --------------------------------------------------------

    save_json(all_reports)

    print()
    print("==============================================")
    print(" Download completed")
    print("==============================================")
    print(f"Total reports: {len(all_reports)}")
    print(f"Pages processed: {page - 1}")
    print(f"Output file: {Path(OUTPUT_FILE).resolve()}")
    print()


if __name__ == "__main__":
    main()
